# 選擇要啟動的平台：discord（預設）/ telegram / line
BOT_PLATFORM=discord

# === Discord ===
# 從 Discord Developer Portal 取得: https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here
# 測試伺服器 ID（開發時用，可加快指令同步；正式部署可留空）
GUILD_ID=

# === Telegram（選用，BOT_PLATFORM=telegram 時才需要） ===
# 從 @BotFather 取得
TELEGRAM_BOT_TOKEN=

# === LINE（選用，BOT_PLATFORM=line 時才需要） ===
# 從 LINE Developers Console 取得
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# 日誌等級 (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Which platform to start: discord (default) / telegram / line
BOT_PLATFORM=discord

# === Discord ===
# Get a token from the Discord Developer Portal: https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here
# Test server ID (dev only; speeds up command sync). Leave empty in production.
GUILD_ID=

# === Telegram (optional; only needed when BOT_PLATFORM=telegram) ===
# Get a token from @BotFather
TELEGRAM_BOT_TOKEN=

# === LINE (optional; only needed when BOT_PLATFORM=line) ===
# Get these from the LINE Developers Console
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

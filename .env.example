# Discord Bot Token
# 從 Discord Developer Portal 取得: https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here

# 測試伺服器 ID（開發時用，可加快指令同步）
# 右鍵點擊伺服器 -> 複製伺服器 ID
GUILD_ID=

# 日誌等級 (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Claude API Key (用於李鴻章角色扮演功能)
# 從 https://console.anthropic.com/ 取得
ANTHROPIC_API_KEY=your_anthropic_api_key_here
